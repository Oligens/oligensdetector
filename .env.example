# Frontend — safe to expose through Vite build
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Vercel server-side only — NEVER prefix these with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
APP_URL=https://YOUR-APP.vercel.app

# Zakapro server-side adapter
ZAKAPRO_API_URL=https://YOUR-ZAKAPRO-ENDPOINT
ZAKAPRO_API_KEY=YOUR_ZAKAPRO_API_KEY
ZAKAPRO_WEBHOOK_SECRET=GENERATE_A_LONG_RANDOM_SECRET
