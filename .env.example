# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Optional direct endpoint for psql/migrations
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Authentication
AUTH_SECRET="GENERATE_A_LONG_RANDOM_SECRET"

# Gmail SMTP - use a Google App Password, never your normal Gmail password
GMAIL_SMTP_USER="your-gmail-address@gmail.com"
GMAIL_SMTP_APP_PASSWORD="your-16-character-google-app-password"

# ZakaPro / MonCash / NatCash server-side credentials
ZAKAPRO_API_URL="https://YOUR-ZAKAPRO-API-ENDPOINT"
ZAKAPRO_API_KEY="YOUR_ZAKAPRO_API_KEY"
ZAKAPRO_WEBHOOK_SECRET="YOUR_ZAKAPRO_WEBHOOK_SECRET"

# Optional lifetime prices in HTG. Leave unset until officially defined.
LIFETIME_PRO_HTG=""
LIFETIME_GOLD_HTG=""
