{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|src(?:/|$)|@vite(?:/|$)|@react-refresh(?:/|$)|node_modules(?:/|$)|assets(?:/|$)|.*\\.).*)",
      "destination": "/index.html"
    },
    {
      "source": "/api/auth/:route*",
      "destination": "/api/[...all]?all=auth/:route*"
    },
    {
      "source": "/api/stats",
      "destination": "/api/[...all]?all=stats"
    },
    {
      "source": "/api/institutional-databases",
      "destination": "/api/[...all]?all=institutional-databases"
    },
    {
      "source": "/api/reports",
      "destination": "/api/[...all]?all=reports"
    },
    {
      "source": "/api/analyses",
      "destination": "/api/[...all]?all=analyses"
    },
    {
      "source": "/api/config",
      "destination": "/api/[...all]?all=config"
    },
    {
      "source": "/api/extract",
      "destination": "/api/[...all]?all=extract"
    }
  ],
  "headers": [
    {
      "source": "/api/webhooks/zakapro",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
